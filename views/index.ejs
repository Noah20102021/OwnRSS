<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/css/output.css'/>
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <link rel="shortcut icon" href="/favicon.ico"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/>
    <meta name="apple-mobile-web-app-title" content="OwnRSS"/>
    <link rel="manifest" href="/site.webmanifest"/>
    <link
            rel="stylesheet"
            type="text/css"
            href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css"
    />
    <link
            rel="stylesheet"
            type="text/css"
            href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/fill/style.css"
    />
</head>

<body class="bg-gradient-to-br from-neutral to-primary/10">
<div class="min-h-dvh grid grid-cols-1 md:grid-cols-12">
    <div class="hidden lg:col-span-7 lg:flex items-center justify-center p-12">
        <img src="/images/logos/OwnRSS_Logo_Horizontal.png" alt="OwnRSS Logo" class="max-w-md w-full">
    </div>
    <div class="lg:col-span-5 col-span-1 m-10 md: flex items-center justify-center">
        <div class="flex flex-col items-center justify-center bg-white rounded-2xl shadow-xl p-8 max-w-md w-full text-slate-800">
          <div class="flex items-start justify-around gap-x-6 max-w-md w-full h-full">
            <h1 class="text-6xl md:text-6xl leading-none">Hi<span class="text-primary">.</span></h1>
            <p class="text-sm md:text-2xl leading-tight">Welcome back, <br> please log in to continue.</p>
          </div>
            <form action="" class="flex flex-col max-w-md w-full text-slate-800">
                <input class="m-1 mb-0 text-xl" type="email" id="email" name="username" placeholder="Email" required>
                <p id="info-mail" class="m-1 mt-0 hidden text-danger text-md">TSGDSGSG</p>
                <input class="m-1 mt-2 mb-0 text-xl" type="password" id="password" name="password"
                       placeholder="Password" required>
                <a href="" class="self-end mt-0.5">Forgot password?</a>
                <p id="info-password" class="m-1 mt-0 hidden text-danger text-md"></p>
              <button type="submit"
                      class="w-full bg-primary font-medium cursor-pointer p-3 m-1 mt-3 transition text-md md:text-lg duration-300 ease-in-out hover:bg-primary-dark rounded-2xl group">
                Login <span class="inline-block transition-transform duration-300 ease-in-out group-hover:translate-x-1">→</span>
              </button>
              <button type="button"
                               class="flex items-center justify-center gap-2 w-full bg-neutral text-slate-700 font-medium p-3 m-1 mt-3 transition text-md md:text-lg duration-300 ease-in-out hover:bg-neutral-dark rounded-2xl group">
                <img class="h-[1em] w-auto object-contain" src="https://upload.wikimedia.org/wikipedia/commons/3/3c/Google_Favicon_2025.svg" alt="Google Logo">
                <span>Login with Google</span>
                <span class="inline-block transition-transform duration-300 ease-in-out group-hover:translate-x-1">→</span>
              </button>
            </form>

            <div class="flex-col p-1 flex max-w-md w-full">
                <p class="text-sm md:text-lg" >Don't have an Account? <a href="">Sign up</a></p>
            </div>
        </div>
    </div>
</div>
</body>

</html>
